# Normaliza los finales de línea: LF en el repositorio, lo que use cada sistema
# en el working copy. Sin esto, un proyecto tocado desde Windows y Linux genera
# diffs enteros por cambios de CRLF/LF.
* text=auto eol=lf

# Scripts que dependen del final de línea para poder ejecutarse
*.sh          text eol=lf
mvnw          text eol=lf
gradlew       text eol=lf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Binarios: nunca convertir
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.ico         binary
*.mp3         binary
*.mp4         binary
*.wav         binary
*.ttf         binary
*.otf         binary
*.woff        binary
*.woff2       binary
*.jar         binary
*.docx        binary
*.pdf         binary
*.keystore    binary
*.jks         binary
